# Sviluppo locale di Vorya QR. Copiare in .env (make init genera POSTGRES_PASSWORD).
# Solo nomi e segnaposto: non inserire segreti reali in questo file.
POSTGRES_USER=vorya_qr
POSTGRES_DB=vorya_qr
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://vorya_qr:PASSWORD@127.0.0.1:5433/vorya_qr
TEST_DATABASE_URL=postgresql+psycopg://vorya_qr:PASSWORD@127.0.0.1:5433/vorya_qr_test
E2E_DATABASE_URL=postgresql+psycopg://vorya_qr:PASSWORD@127.0.0.1:5433/vorya_qr_e2e
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
SHORT_LINK_BASE_URL=http://localhost:3000
PUBLIC_REGISTRATION_ENABLED=true
SUPPORT_EMAIL=supporto@vorya.it
MAIL_TRANSPORT=file
MAIL_FILE_DIR=.mail-outbox
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@vorya.it
SMTP_FROM_NAME=Vorya QR
API_INTERNAL_URL=http://127.0.0.1:8000
# 0.2: file storage ("local" = Docker volume; "s3" = S3-compatible service)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.uploads
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_PREFIX=vorya-qr/
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# 0.2: DB-IP Lite City (mmdb), never committed: python -m app.cli download-geoip
GEOIP_DB_PATH=./.geoip/dbip-city-lite.mmdb
# 0.2: Google Safe Browsing (empty = check skipped)
SAFE_BROWSING_API_KEY=

# --- Stripe (0.3) ---------------------------------------------------------------------
# Solo chiavi: i prezzi dei piani si gestiscono dall'admin (tabella billing_prices) e si
# collegano agli ID prezzo Stripe. Nessun importo nel codice o nell'ambiente.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Le chiavi sk_live_/rk_live_ funzionano solo con STRIPE_LIVE_ALLOWED=true.
STRIPE_LIVE_ALLOWED=false

# ---- 0.5 ----
# Errori (GlitchTip DSN backend) e dettaglio salute (header X-Health-Token)
SENTRY_DSN=
HEALTH_TOKEN=
LOG_FORMAT=json
# Frontend: valori incorporati in BUILD (serve ricostruire l'immagine se cambiano)
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION=
# Servizi opzionali: COMPOSE_PROFILES=analytics,errors,backup
UMAMI_DB_PASSWORD=
UMAMI_APP_SECRET=
UMAMI_HTTP_PORT=3300
GLITCHTIP_DB_PASSWORD=
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DOMAIN=https://errori.vorya.it
GLITCHTIP_EMAIL_URL=
GLITCHTIP_HTTP_PORT=3400
# Backup cifrati (restic su storage S3 esterno al VPS)
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_CRON=15 3 * * *
BACKUP_EXTRA_DATABASES=umami glitchtip
BACKUP_PING_URL=

# Sviluppo locale di Vorya QR. Copiare in .env (make init genera POSTGRES_PASSWORD).
# Solo nomi e segnaposto: non inserire segreti reali in questo file.
POSTGRES_USER=vorya_qr
POSTGRES_DB=vorya_qr
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://vorya_qr:PASSWORD@127.0.0.1:5433/vorya_qr
TEST_DATABASE_URL=postgresql+psycopg://vorya_qr:PASSWORD@127.0.0.1:5433/vorya_qr_test
E2E_DATABASE_URL=postgresql+psycopg://vorya_qr:PASSWORD@127.0.0.1:5433/vorya_qr_e2e
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
SHORT_LINK_BASE_URL=http://localhost:3000
PUBLIC_REGISTRATION_ENABLED=true
SUPPORT_EMAIL=supporto@vorya.it
MAIL_TRANSPORT=file
MAIL_FILE_DIR=.mail-outbox
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@vorya.it
SMTP_FROM_NAME=Vorya QR
API_INTERNAL_URL=http://127.0.0.1:8000
# 0.2: file storage ("local" = Docker volume; "s3" = S3-compatible service)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.uploads
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_PREFIX=vorya-qr/
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# 0.2: DB-IP Lite City (mmdb), never committed: python -m app.cli download-geoip
GEOIP_DB_PATH=./.geoip/dbip-city-lite.mmdb
# 0.2: Google Safe Browsing (empty = check skipped)
SAFE_BROWSING_API_KEY=

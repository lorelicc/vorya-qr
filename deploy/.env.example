# Variabili dello stack Portainer per Vorya QR 0.2.
# Solo nomi e segnaposto: inserire i valori reali in Portainer (Stack > Environment variables).
POSTGRES_USER=vorya_qr
POSTGRES_DB=vorya_qr
POSTGRES_PASSWORD=CAMBIARE_password_url_safe
# Porta locale (solo 127.0.0.1) verso cui punta CloudPanel. Default 3200.
VORYA_QR_HTTP_PORT=3200
PUBLIC_BASE_URL=https://qr.vorya.it
SHORT_LINK_BASE_URL=https://qr.vorya.it
PUBLIC_REGISTRATION_ENABLED=true
SUPPORT_EMAIL=supporto@vorya.it
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=noreply@vorya.it
SMTP_PASSWORD=CAMBIARE
SMTP_FROM_EMAIL=noreply@vorya.it
SMTP_FROM_NAME=Vorya QR
SMTP_TIMEOUT=10
# 0.2: file storage ("local" = Docker volume; "s3" = S3-compatible service)
STORAGE_DRIVER=local
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_PREFIX=vorya-qr/
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# 0.2: DB-IP Lite City (mmdb): percorso fisso /data/geoip nel volume geoip_data
# 0.2: Google Safe Browsing (empty = check skipped)
SAFE_BROWSING_API_KEY=

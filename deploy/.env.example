# Variabili dello stack Portainer per Vorya QR 0.1.
# Solo nomi e segnaposto: inserire i valori reali in Portainer (Stack > Environment variables).
POSTGRES_USER=vorya_qr
POSTGRES_DB=vorya_qr
POSTGRES_PASSWORD=CAMBIARE_password_url_safe
PUBLIC_BASE_URL=https://qr.vorya.it
SHORT_LINK_BASE_URL=https://qr.vorya.it
PUBLIC_REGISTRATION_ENABLED=true
SUPPORT_EMAIL=supporto@vorya.it
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=noreply@vorya.it
SMTP_PASSWORD=CAMBIARE
SMTP_FROM_EMAIL=noreply@vorya.it
SMTP_FROM_NAME=Vorya QR
SMTP_TIMEOUT=10
